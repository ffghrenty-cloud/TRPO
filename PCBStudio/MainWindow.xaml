<Window x:Class="PCBStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PCB Studio — редактор печатных плат" Height="820" Width="1320" MinHeight="650" MinWidth="1000" Background="#101820" Foreground="#E8F0F5" FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">
 <Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#263746"/><Setter Property="Foreground" Value="#E8F0F5"/><Setter Property="BorderBrush" Value="#405363"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style><Style TargetType="TextBox"><Setter Property="Background" Value="#101820"/><Setter Property="Foreground" Value="#E8F0F5"/><Setter Property="BorderBrush" Value="#405363"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="3"/></Style><Style TargetType="ComboBox"><Setter Property="Background" Value="#263746"/><Setter Property="Foreground" Value="#17212B"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/></Style></Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#17212B" Padding="14"><DockPanel><StackPanel Orientation="Horizontal"><Border Background="#39D0B0" CornerRadius="5" Padding="9,5" Margin="0,0,10,0"><TextBlock Text="PCB" Foreground="#101820" FontWeight="Bold"/></Border><StackPanel><TextBlock Text="PCB Studio" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Редактор печатных плат · миллиметровая сетка" Foreground="#9BAFBD" FontSize="11"/></StackPanel></StackPanel><TextBlock x:Name="ProjectLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#9BAFBD" Text="Новый проект"/></DockPanel></Border>
  <Border DockPanel.Dock="Top" Background="#202D39" Padding="6"><WrapPanel VerticalAlignment="Center"><Button Content="Выбор (V)" Click="SelectMode_Click"/><Button Content="+ Компонент" Click="AddComponent_Click" Background="#246858"/><Button Content="Дорожка (T)" Click="TrackMode_Click"/><Button Content="Отверстие (H)" Click="HoleMode_Click"/><Separator Width="1" Margin="8,3" Background="#405363"/><Button Content="Повернуть (R)" Click="Rotate_Click"/><Button Content="Удалить (Del)" Click="Delete_Click"/><Button Content="Отменить (Ctrl+Z)" Click="Undo_Click"/><Button Content="Сетка" Click="Grid_Click"/><Button Content="Уместить (F)" Click="Fit_Click"/></WrapPanel></Border>
  <Border DockPanel.Dock="Left" Width="235" Background="#17212B" Padding="12"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="ПРОЕКТ" Foreground="#39D0B0" FontWeight="Bold" Margin="3,4,3,8"/><TextBlock Text="Название"/><TextBox x:Name="NameBox" Text="Новая плата"/><TextBlock Text="КОМПОНЕНТ" Foreground="#39D0B0" FontWeight="Bold" Margin="3,18,3,8"/><TextBlock Text="Тип"/><ComboBox x:Name="TypeBox" SelectedIndex="0"><ComboBoxItem Content="Резистор (R)"/><ComboBoxItem Content="Конденсатор (C)"/><ComboBoxItem Content="Микросхема (U)"/><ComboBoxItem Content="Разъём (J)"/><ComboBoxItem Content="Диод (D)"/></ComboBox><TextBlock Text="Обозначение"/><TextBox x:Name="RefBox" Text="R1"/><TextBlock Text="Номинал"/><TextBox x:Name="ValueBox" Text="10k"/><TextBlock Text="ДОРОЖКА" Foreground="#39D0B0" FontWeight="Bold" Margin="3,18,3,8"/><TextBlock Text="Ширина (мм)"/><ComboBox x:Name="WidthBox" SelectedIndex="1"><ComboBoxItem Content="0.25"/><ComboBoxItem Content="0.35"/><ComboBoxItem Content="0.50"/><ComboBoxItem Content="0.80"/></ComboBox><TextBlock Text="СЛОЙ"/><ComboBox x:Name="LayerBox" SelectedIndex="0"><ComboBoxItem Content="Top"/><ComboBoxItem Content="Bottom"/></ComboBox><TextBlock Text="ФАЙЛЫ" Foreground="#39D0B0" FontWeight="Bold" Margin="3,18,3,8"/><Button Content="Новый проект (Ctrl+N)" Click="New_Click"/><Button Content="Открыть (Ctrl+O)" Click="Open_Click"/><Button Content="Сохранить (Ctrl+S)" Click="Save_Click"/><Button Content="Экспорт SVG" Click="Export_Click"/><Button Content="Проверить плату (DRC)" Click="Drc_Click" Background="#624B28"/><TextBlock x:Name="StatsText" Text="0 компонентов · 0 дорожек" Foreground="#9BAFBD" TextWrapping="Wrap" Margin="4,18,4,4"/></StackPanel></ScrollViewer></Border>
  <DockPanel><Border DockPanel.Dock="Bottom" Background="#17212B" Padding="9"><TextBlock x:Name="StatusText" Text="Готово. Выберите инструмент или добавьте компонент." Foreground="#9BAFBD"/></Border><ScrollViewer x:Name="BoardScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#101820"><Grid x:Name="BoardHost" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas x:Name="BoardCanvas" Width="1000" Height="600" Background="#173D32" MouseLeftButtonDown="Board_MouseDown" MouseMove="Board_MouseMove" MouseLeftButtonUp="Board_MouseUp" MouseWheel="Board_MouseWheel" Focusable="True"/></Grid></ScrollViewer></DockPanel>
 </DockPanel>
</Window>