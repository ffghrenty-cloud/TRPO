<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCB Studio — редактор печатных плат" Height="860" Width="1440"
        MinHeight="680" MinWidth="1100" WindowStartupLocation="CenterScreen"
        Background="#F3F5F8" FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#E8EDF4"/>
            <Setter Property="Foreground" Value="#233044"/>
            <Setter Property="BorderBrush" Value="#D2DAE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#243247"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#FFFFFF" Padding="5">
            <MenuItem Header="_Файл">
                <MenuItem Header="Новый проект" InputGestureText="Ctrl+N" Click="NewProject_Click"/>
                <MenuItem Header="Открыть проект…" InputGestureText="Ctrl+O" Click="OpenProject_Click"/>
                <MenuItem Header="Сохранить проект" InputGestureText="Ctrl+S" Click="SaveProject_Click"/>
                <Separator/>
                <MenuItem Header="Экспорт SVG…" InputGestureText="Ctrl+E" Click="ExportSvg_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Правка">
                <MenuItem Header="Отменить" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem Header="Повторить" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                <Separator/>
                <MenuItem Header="Копировать компонент" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                <MenuItem Header="Вырезать компонент" InputGestureText="Ctrl+X" Click="Cut_Click"/>
                <MenuItem Header="Вставить компонент" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                <MenuItem Header="Дублировать компонент" InputGestureText="Ctrl+D" Click="DuplicateSelected_Click"/>
                <Separator/>
                <MenuItem Header="Удалить выбранный элемент" InputGestureText="Delete" Click="DeleteSelected_Click"/>
                <MenuItem Header="Проверить правила (DRC)" Click="RunDrc_Click"/>
            </MenuItem>
            <MenuItem Header="_Вид">
                <MenuItem Header="Уместить плату / сбросить масштаб" InputGestureText="Ctrl+0" Click="FitBoard_Click"/>
                <MenuItem Header="Показать сетку" InputGestureText="G" IsCheckable="True" IsChecked="True" Click="ToggleGrid_Click"/>
            </MenuItem>
            <MenuItem Header="_Справка (F1)" Click="Help_Click"/>
        </Menu>
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#DCE3EC" BorderThickness="0,1,0,1" Padding="6">
            <WrapPanel Orientation="Horizontal">
                <Button Content="━ Дорожка" Click="TrackMode_Click"/>
                <Button Content="↖ Выбор" Click="SelectMode_Click"/>
                <Button Content="↻ Повернуть" Click="RotateSelected_Click"/>
                <Button Content="⊙ Монтажное отверстие" Click="AddMountingHole_Click" ToolTip="Добавить отверстие Ø3,2 мм (H)"/>
                <Button Content="⌫ Удалить" Click="DeleteSelected_Click"/>
                <TextBlock Text="Ширина:" VerticalAlignment="Center" Margin="8,0,2,0"/>
                <ComboBox x:Name="TrackWidthComboBox" Width="74" SelectedIndex="1" VerticalContentAlignment="Center" Margin="2">
                    <ComboBoxItem Content="0,25 мм" Tag="0.25"/>
                    <ComboBoxItem Content="0,35 мм" Tag="0.35"/>
                    <ComboBoxItem Content="0,50 мм" Tag="0.50"/>
                    <ComboBoxItem Content="0,75 мм" Tag="0.75"/>
                </ComboBox>
                <TextBlock Text="Слой:" VerticalAlignment="Center" Margin="6,0,2,0"/>
                <ComboBox x:Name="TrackLayerComboBox" Width="86" SelectedIndex="0" VerticalContentAlignment="Center" Margin="2">
                    <ComboBoxItem Content="Top Copper" Tag="Top"/>
                    <ComboBoxItem Content="Bottom Copper" Tag="Bottom"/>
                </ComboBox>
                <CheckBox x:Name="SnapCheck" Content="Привязка" IsChecked="True" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <Separator Margin="8,2"/>
                <Button Content="Проверить DRC" Click="RunDrc_Click" Background="#FFF0D2"/>
                <Button Content="Сохранить" Click="SaveProject_Click" Background="#DDF6E7"/>
                <TextBlock Text="Колесо — прокрутка • Ctrl+колесо — масштаб • средняя кнопка — панорама"
                           VerticalAlignment="Center" Margin="18,0,0,0" Foreground="#65748A" FontSize="12"/>
            </WrapPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#DCE3EC" BorderThickness="0,1,0,0">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="Готово. Добавьте компонент из библиотеки или выберите элемент на плате."/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="ZoomText" Text="Масштаб: 100%"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="CountText" Text="Компоненты: 0 • Дорожки: 0"/></StatusBarItem>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#DCE3EC" BorderThickness="0,0,1,0" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="БИБЛИОТЕКА КОМПОНЕНТОВ" Style="{StaticResource PanelTitle}"/>
                    <TextBlock DockPanel.Dock="Top" Text="Выберите компонент в списке, наведите курсор на плату и щёлкните ЛКМ один раз для установки." TextWrapping="Wrap" Foreground="#718096" FontSize="11" Margin="0,0,0,12"/>
                    <TextBox x:Name="LibrarySearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="7" ToolTip="Поиск по имени, обозначению или типу компонента" TextChanged="LibrarySearchBox_TextChanged" KeyDown="LibrarySearchBox_KeyDown"/>
                    <ListBox x:Name="LibraryList" BorderBrush="#DCE3EC" PreviewMouseLeftButtonDown="LibraryList_PreviewMouseLeftButtonDown">
                        <ListBoxItem Content="Резистор (R)" Tag="R" IsSelected="True" Padding="8"/>
                        <ListBoxItem Content="Конденсатор (C)" Tag="C" Padding="8"/>
                        <ListBoxItem Content="Светодиод (D)" Tag="D" Padding="8"/>
                        <ListBoxItem Content="Микросхема (U)" Tag="U" Padding="8"/>
                        <ListBoxItem Content="Разъём (J)" Tag="J" Padding="8"/>
                        <ListBoxItem Content="Транзистор (Q)" Tag="Q" Padding="8"/>
                        <ListBoxItem Content="Катушка индуктивности (L)" Tag="L" Padding="8"/>
                        <ListBoxItem Content="Переключатель (SW)" Tag="SW" Padding="8"/>
                        <ListBoxItem Content="Штыревой разъём 2,54 мм (H)" Tag="H" Padding="8"/>
                    </ListBox>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="СОВЕТ" FontWeight="Bold" FontSize="10" Foreground="#6B7B90" Margin="2,12,0,4"/>
                        <TextBlock Text="Выберите тип компонента — его предпросмотр появится сразу. При трассировке щёлкайте по контактным площадкам; Esc отменяет трассу." TextWrapping="Wrap" FontSize="11" Foreground="#718096"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Background="#E9EEF5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#F8FAFC" Padding="12,8" BorderBrush="#DCE3EC" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock Text="PCB / BOARD 1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="FR-4 • 2 слоя • мм" Foreground="#7A8798" FontSize="11" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="BoardScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" PanningMode="Both">
                    <Canvas x:Name="BoardCanvas" Width="1400" Height="900" Background="#111A28"
                            ClipToBounds="True"
                            PreviewMouseLeftButtonDown="BoardCanvas_PreviewMouseLeftButtonDown"
                            MouseMove="BoardCanvas_MouseMove" MouseLeftButtonUp="BoardCanvas_MouseLeftButtonUp"
                            MouseWheel="BoardCanvas_MouseWheel" MouseDown="BoardCanvas_MouseDown" MouseUp="BoardCanvas_MouseUp"/>
                </ScrollViewer>
            </Grid>
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#DCE3EC" BorderThickness="1,0,0,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="СВОЙСТВА" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Выбранный объект" FontSize="11" Foreground="#718096" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SelectedName" Text="Ничего не выбрано" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <Separator Margin="0,0,0,12"/>
                        <TextBlock Text="Обозначение и значение" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="ReferenceBox" ToolTip="Например, R1" Padding="6" Margin="0,0,0,6"/>
                        <TextBox x:Name="ValueBox" ToolTip="Например, 10k" Padding="6" Margin="0,0,0,10"/>
                        <TextBlock Text="Положение (мм)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="X"/>
                                <TextBox x:Name="XBox" Text="0" Padding="6" Margin="0,3,0,8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Y"/>
                                <TextBox x:Name="YBox" Text="0" Padding="6" Margin="0,3,0,8"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="Применить свойства" Click="ApplyProperties_Click" Background="#DCEBFF"/>
                        <TextBlock Text="Подсказка: можно перетащить компонент мышью. Во время размещения нажмите R для поворота, Esc — отмена." TextWrapping="Wrap" FontSize="11" Foreground="#718096" Margin="0,8,0,0"/>
                        <Separator Margin="0,12"/>
                        <TextBlock Text="СЛОИ" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                        <CheckBox x:Name="TopLayerCheck" Content="Верхний слой (Top Copper)" IsChecked="True" Margin="0,5" Checked="LayerVisibility_Changed" Unchecked="LayerVisibility_Changed"/>
                        <CheckBox x:Name="BottomLayerCheck" Content="Нижний слой (Bottom Copper)" IsChecked="True" Margin="0,5" Checked="LayerVisibility_Changed" Unchecked="LayerVisibility_Changed"/>
                        <CheckBox x:Name="SilkLayerCheck" Content="Шелкография (Silkscreen)" IsChecked="True" Margin="0,5" Checked="LayerVisibility_Changed" Unchecked="LayerVisibility_Changed"/>
                        <Separator Margin="0,12"/>
                        <TextBlock Text="ПРАВИЛА ПРОЕКТИРОВАНИЯ" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                        <TextBlock Text="Минимальная ширина дорожки" FontSize="11" Foreground="#718096"/>
                        <TextBlock Text="0,25 мм • настраивается в панели сверху" FontWeight="SemiBold" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <TextBlock Text="Мин. зазор" FontSize="11" Foreground="#718096"/>
                        <TextBlock Text="0,20 мм" FontWeight="SemiBold" Margin="0,2,0,8"/>
                        <TextBlock Text="Мин. диаметр отверстия" FontSize="11" Foreground="#718096"/>
                        <TextBlock Text="0,30 мм" FontWeight="SemiBold" Margin="0,2,0,8"/>
                        <Button Content="Запустить проверку DRC" Click="RunDrc_Click" Background="#FFF0D2" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
